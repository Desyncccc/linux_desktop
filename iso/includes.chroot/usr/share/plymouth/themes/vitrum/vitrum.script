# Vitrum boot splash: logo on a deep blue gradient with pulsing dots.
Window.SetBackgroundTopColor(0.03, 0.10, 0.22);
Window.SetBackgroundBottomColor(0.08, 0.30, 0.58);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

label.image = Image.Text("Starting Vitrum", 1, 1, 1, 1, "Sans 13");
label.sprite = Sprite(label.image);
label.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - label.image.GetWidth() / 2);
label.sprite.SetY(logo.sprite.GetY() + logo.image.GetHeight() + 28);

dot_image = Image("dot.png");
for (i = 0; i < 5; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetX(Window.GetX() + Window.GetWidth() / 2 - 40 + i * 18);
    dots[i].SetY(label.sprite.GetY() + 34);
    dots[i].SetOpacity(0.25);
}

frame = 0;
fun refresh() {
    frame++;
    for (i = 0; i < 5; i++) {
        phase = (frame / 6 - i) % 5;
        if (phase < 0) phase += 5;
        if (phase < 1) dots[i].SetOpacity(1);
        else dots[i].SetOpacity(0.25);
    }
}
Plymouth.SetRefreshFunction(refresh);
