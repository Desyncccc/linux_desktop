#!/bin/sh
# Vitrum installer, inside the new system: install the boot loader packages
# for this machine's firmware from copies kept on the live system (no
# network needed). UEFI gets the signed loader so Secure Boot keeps working.
dir=/usr/lib/vitrum/installer
export DEBIAN_FRONTEND=noninteractive
if [ -d /sys/firmware/efi ]; then
    set -- "$dir"/efi/*.deb
else
    echo "grub-pc grub-pc/install_devices_empty boolean true" | debconf-set-selections 2>/dev/null || true
    set -- "$dir"/bios/*.deb
fi
if [ -e "$1" ]; then
    dpkg -i "$@" || dpkg --configure -a || true
fi
if ! command -v grub-install >/dev/null 2>&1; then
    echo "Vitrum installer: the boot loader packages are missing" >&2
    exit 1
fi
exit 0
