#!/bin/sh
# Start a Vitrum desktop session.
#
# From a display manager this runs on its own VT; from a text console (e.g.
# autologin on tty1) it drives the display directly through DRM/KMS. If KMS
# isn't usable (some virtual GPUs) it falls back to a bare X server.

export XDG_CURRENT_DESKTOP=Vitrum
export XDG_SESSION_DESKTOP=vitrum
export XDG_SESSION_TYPE=wayland
export DESKTOP_SESSION=vitrum

# Wayland needs a private runtime directory (normally created by logind).
if [ -z "$XDG_RUNTIME_DIR" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
    XDG_RUNTIME_DIR="/tmp/vitrum-runtime-$(id -u)"
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 0700 "$XDG_RUNTIME_DIR"
    export XDG_RUNTIME_DIR
fi

# Many apps (the foot terminal among them) refuse to run without a UTF-8
# locale. Use the configured one if it is UTF-8, otherwise C.UTF-8.
case "${LC_ALL:-${LANG:-}}" in
    *UTF-8*|*utf8*) ;;
    *)
        if locale -a 2>/dev/null | grep -qi '^en_US\.utf8$'; then export LANG=en_US.UTF-8; else export LANG=C.UTF-8; fi
        unset LC_ALL ;;
esac

# Keyboard layout from the system configuration.
if [ -z "$XKB_DEFAULT_LAYOUT" ] && [ -r /etc/default/keyboard ]; then
    . /etc/default/keyboard
    [ -n "$XKBLAYOUT" ] && export XKB_DEFAULT_LAYOUT="$XKBLAYOUT"
    [ -n "$XKBVARIANT" ] && export XKB_DEFAULT_VARIANT="$XKBVARIANT"
    [ -n "$XKBOPTIONS" ] && export XKB_DEFAULT_OPTIONS="$XKBOPTIONS"
fi

# Already inside a graphical session: run nested (full screen).
if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; then
    exec vitrum "$@"
fi

run() {
    if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
        dbus-run-session -- "$@"
    else
        "$@"
    fi
}

# "Safe graphics" boot option: render in software even if the GPU driver
# offers 3D (works around broken or disabled 3D in some virtual machines).
if grep -qw vitrum.safe-graphics /proc/cmdline 2>/dev/null; then
    export LIBGL_ALWAYS_SOFTWARE=1
fi

export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
export QT_QPA_EGLFS_ALWAYS_SET_MODE=1
# Draw the pointer ourselves: hardware cursor planes are unreliable on
# virtual GPUs (VMware SVGA, VirtualBox, QXL), where it can go invisible.
if [ -z "$QT_QPA_EGLFS_KMS_CONFIG" ]; then
    printf '{ "hwcursor": false }\n' > "$XDG_RUNTIME_DIR/vitrum-kms.json"
    export QT_QPA_EGLFS_KMS_CONFIG="$XDG_RUNTIME_DIR/vitrum-kms.json"
fi
log="${XDG_RUNTIME_DIR:-/tmp}/vitrum-session.log"

echo "== $(date) starting Vitrum on DRM/KMS" >"$log"
start=$(date +%s)
run vitrum "$@" >>"$log" 2>&1
rc=$?
elapsed=$(( $(date +%s) - start ))
echo "== vitrum exited with $rc after ${elapsed}s" >>"$log"

# A quick failure with a GPU present is usually a broken or disabled 3D
# driver (common in virtual machines): try again rendering in software.
if [ "$rc" -ne 0 ] && [ "$elapsed" -lt 15 ] && [ -z "$LIBGL_ALWAYS_SOFTWARE" ] && ls /dev/dri/card* >/dev/null 2>&1; then
    echo "== retrying with software rendering" >>"$log"
    export LIBGL_ALWAYS_SOFTWARE=1
    start=$(date +%s)
    run vitrum "$@" >>"$log" 2>&1
    rc=$?
    elapsed=$(( $(date +%s) - start ))
    echo "== vitrum (software) exited with $rc after ${elapsed}s" >>"$log"
fi

# Exit 0 is a normal sign-out. A quick failure means KMS didn't work.
if [ "$rc" -ne 0 ] && [ "$elapsed" -lt 15 ] && command -v xinit >/dev/null 2>&1; then
    echo "== falling back to an X server" >>"$log"
    unset QT_QPA_EGLFS_INTEGRATION QT_QPA_EGLFS_ALWAYS_SET_MODE QT_QPA_EGLFS_KMS_CONFIG
    export QT_QPA_PLATFORM=xcb
    status="$XDG_RUNTIME_DIR/vitrum-x-status"
    rm -f "$status"
    vt="vt${XDG_VTNR:-1}"
    # xinit doesn't pass on the client's exit code; record it ourselves.
    xinit /bin/sh -c "vitrum $*; echo \$? > '$status'" -- :0 "$vt" -nolisten tcp -keeptty >>"$log" 2>&1
    rc=$(cat "$status" 2>/dev/null || echo 1)
    echo "== vitrum (X) exited with $rc" >>"$log"
fi
exit "$rc"
